<odoo>

    <record id="view_hospital_patient_list" model="ir.ui.view">
        <field name="name">hospital.patient.list</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref"/>
                <field name="name"/>
                <field name="gender"/>
                <field name="dob"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_patient_form" model="ir.ui.view">
        <field name="name">hospital.patient.form</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <form>

                <header>

                    <button
                            name="action_activate"
                            type="object"
                            string="Activate"
                            invisible="state != 'draft'"
                    />

                    <button
                            name="action_archive"
                            type="object"
                            string="Archive"
                            invisible="state != 'active'"
                    />

                    <button
                            name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'archived'"
                    />

                    <field name="state" widget="statusbar"/>
                    <button name="action_send_registration_email"
                            type="object"
                            string="Send Registration Email"
                            class="btn-primary"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                                name="action_open_doctors"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user-md"
                                invisible="doctor_count == 0"
                        >
                            <field
                                    name="doctor_count"
                                    widget="statinfo"
                            />
                        </button>

                    </div>

                    <group string="Patient Information">
                        <group>
                            <field name="ref"/>
                            <field name="name"/>
                            <field name="gender"/>
                        </group>

                        <group>
                            <field name="dob"/>
                            <field name="age"/>
                            <field name="age_group"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Contact Information">
                            <group>
                                <group>
                                    <field name="phone" widget="phone"/>
                                    <field name="email" widget="email"/>
                                </group>

                                <group>
                                    <field name="address"/>
                                </group>
                            </group>
                        </page>

                        <page string="Medical Information">
                            <group>
                                <field name="doctor_id"/>
                                <field name="doctor_specialization"/>
                                <field name="doctor_ids" widget="many2many_tags"/>
                            </group>
                        </page>

                        <page string="Additional Information">
                            <group>
                                <field name="registration_date"/>
                                <field name="active"/>
                                <field name="notes"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hospital_patient_search" model="ir.ui.view">
        <field name="name">hospital.patient.search</field>
        <field name="model">hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="ref"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="doctor_id"/>

                <filter
                        name="active_patients"
                        string="Active Patients"
                        domain="[('state', '=', 'active')]"
                />
                <filter
                        name="inactive_patients"
                        string="Inactive Patients"
                        domain="[('state', '=', 'archived')]"
                />
                <filter
                        name="patients_with_doctor"
                        string="Patients with Doctor"
                        domain="[('doctor_id', '!=', False)]"
                />
                <filter
                        name="patients_without_doctor"
                        string="Patients without Doctor"
                        domain="[('doctor_id', '=', False)]"
                />
                <filter
                        name="draft_patients"
                        string="Draft Patients"
                        domain="[('state', '=', 'draft')]"
                />

                <group>
                    <filter
                            name="group_by_doctor"
                            string="Primary Doctor"
                            context="{'group_by': 'doctor_id'}"
                    />
                    <filter
                            name="group_by_gender"
                            string="Gender"
                            context="{'group_by': 'gender'}"
                    />
                    <filter
                            name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}"
                    />
                </group>

                <searchpanel>
                    <field name="doctor_id"/>
                    <field name="gender"/>
                    <field name="state"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hospital_patients" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_patient_search"/>
    </record>

</odoo>