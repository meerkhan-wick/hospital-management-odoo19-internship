<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_hospital_doctor_list" model="ir.ui.view">
        <field name="name">hospital.doctor.list</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="license_ref"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                                name="action_open_patients"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-users"
                                invisible="patient_count == 0"
                        >
                            <field
                                    name="patient_count"
                                    widget="statinfo"
                            />
                        </button>

                    </div>

                    <group>
                        <group string="Doctor Information">
                            <field name="name"/>
                            <field name="license_ref"/>
                            <field name="specialization"/>
                        </group>

                        <group string="Contact Information">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Patients">
                            <field name="patient_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="ref"/>
                                    <field name="age"/>
                                    <field name="gender"/>
                                </list>
                            </field>
                        </page>

                        <page string="Professional Information">
                            <group>
                                <field name="license_ref"/>
                                <field name="specialization"/>
                            </group>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="license_ref"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>

                <filter
                        name="active_doctors"
                        string="Active Doctors"
                        domain="[('active', '=', True)]"
                />

                <filter
                        name="inactive_doctors"
                        string="Inactive Doctors"
                        domain="[('active', '=', False)]"
                />

                <filter
                        name="doctors_with_patients"
                        string="Doctors with Patients"
                        domain="[('patient_ids', '!=', False)]"
                />

                <filter
                        name="doctors_without_patients"
                        string="Doctors without Patients"
                        domain="[('patient_ids', '=', False)]"
                />

                <filter
                        name="specialists"
                        string="Specialized Doctors"
                        domain="[('specialization', '!=', False)]"
                />

                <group>
                    <filter
                            name="group_by_specialization"
                            string="Specialization"
                            context="{'group_by': 'specialization'}"
                    />

                    <filter
                            name="group_by_active"
                            string="Status"
                            context="{'group_by': 'active'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hospital_doctor_search"/>

    </record>

</odoo>